PORT=3000
NODE_ENV=development

# REQUIRED in production — long random string (openssl rand -hex 32)
JWT_SECRET=

# Public HTTPS URL of this server (Twilio webhooks + media stream). ngrok URL in dev.
WEBHOOK_URL=

# Comma-separated origins allowed in production (dashboard/mobile)
ALLOWED_ORIGINS=
# Public HTTPS address of this server, e.g. https://vexa.onrender.com (Render sets RENDER_EXTERNAL_URL itself)
PUBLIC_URL=

# ============================================
# Database
# ============================================
# Leave empty in development → an embedded MongoDB starts automatically
# (data persisted in backend/.data/mongo). Required in production.
MONGODB_URI=

# ============================================
# Claude (Anthropic) — call understanding, post-call analysis, "Ask Vexa"
# ============================================
# When set, Claude is used for all text intelligence (preferred over OpenAI).
ANTHROPIC_API_KEY=
# Default claude-opus-5-5. For the lowest per-turn latency on live calls you can
# choose claude-haiku-4-5 (faster, cheaper, less capable).
ANTHROPIC_MODEL=claude-opus-5-5
# Server-side refusal fallback: "default" (on) or "off"
ANTHROPIC_FALLBACKS=default
# Optional model for per-turn work (understanding, language detection, translation).
# Measured on the 161-case understanding set (backend/eval/nlu/FAST_MODELS.md):
#   claude-sonnet-5-5  98%, every fact right, ~2.1 s, $0.0065 per caller sentence  (recommended)
#   claude-haiku-5-5   96%, missed 2 facts,    ~2.6 s, $0.0003 per caller sentence  (cheapest)
# Post-call analysis stays on ANTHROPIC_MODEL.
ANTHROPIC_FAST_MODEL=
# Per-turn understanding timeout on calls (ms); on timeout the offline engine answers
NLU_TIMEOUT_MS=5000

# ============================================
# OpenAI (optional) — needed only for live phone VOICE (Realtime speech).
# Without Claude, it is also used for text intelligence.
# ============================================
OPENAI_API_KEY=
# Leave empty for api.openai.com. Set to https://<resource>.openai.azure.com for Azure OpenAI.
OPENAI_ENDPOINT=
# Model names (api.openai.com) or deployment names (Azure)
OPENAI_DEPLOYMENT_NAME=gpt-realtime-mini
OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
OPENAI_API_VERSION=2024-10-01-preview

# ============================================
# Twilio (required for live phone calls + SMS login codes in production)
# ============================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Recommended for login codes in production
TWILIO_VERIFY_SERVICE_SID=
# Defaults to true in production. Rejects webhooks without a valid Twilio signature.
# TWILIO_VALIDATE_SIGNATURE=true

# Dev only: send real SMS codes instead of returning them to the client
# OTP_FORCE_SMS=true

# ============================================
# Push notifications (optional)
# ============================================
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Demo data endpoint is on in development; set true to allow it in production demos
# ENABLE_DEMO_DATA=false

# ============================================
# Call recording
# ============================================
# Where stereo WAVs are stored (default backend/.data/recordings). Owners control
# on/off, the "may be recorded" notice and retention (7–365 days) in the app.
RECORDINGS_DIR=

# ============================================
# Security and the Android app
# ============================================
# Signs the single-use token that authorises each call's audio stream.
# Optional: derived from JWT_SECRET when unset. Rotating it only affects calls being connected.
STREAM_TOKEN_SECRET=
# Local tools only: STREAM_AUTH=off skips the stream token check (ignored in production)
# STREAM_AUTH=off
# The Android app prompts to update below LATEST_APP_VERSION and refuses to run below MIN_APP_VERSION
MIN_APP_VERSION=
LATEST_APP_VERSION=

# ============================================
# Call behaviour
# ============================================
# How long (ms) a caller must keep talking over Vexa before it stops speaking
BARGE_IN_MS=600
# Country code for 10-digit spoken phone numbers
DEFAULT_COUNTRY_CODE=+91
# Owner-run test calls get a longer understanding budget than live calls
TEST_NLU_TIMEOUT_MS=12000

# ============================================
# Sign in with Google (optional; the internet-first login when SMS isn't set up)
# ============================================
# OAuth client ID (Web application) from console.cloud.google.com → APIs & Services → Credentials.
# Add your site (e.g. https://vexa.onrender.com) under Authorized JavaScript origins.
GOOGLE_CLIENT_ID=

# ============================================
# Web Push notifications (installed app / browser) — no Firebase needed
# ============================================
# Generate once: npx web-push generate-vapid-keys   (development generates its own in backend/.data)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
