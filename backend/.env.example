PORT=3000
NODE_ENV=development
JWT_SECRET=dev-secret-key-change-in-production

# Webhook URL — Backend Deployed URL (used by Twilio and for outbound call callbacks)
WEBHOOK_URL=

# ============================================
# OpenAI Configuration (REQUIRED)
# ============================================
# Get these from Portal > OpenAI > Your Resource
OPENAI_ENDPOINT=
OPENAI_API_KEY=

# Deployment names (create these in OpenAI Studio)
OPENAI_DEPLOYMENT_NAME=gpt-realtime-mini
OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
OPENAI_API_VERSION=2024-10-01-preview



# ============================================
# Twilio Configuration (REQUIRED)
# ============================================
# Get these from Twilio Console > Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ============================================
# MongoDB Atlas Configuration (REQUIRED)
# ============================================
# Get from: MongoDB Atlas > Database > Connect > Drivers
# Replace <db_password> with your database user password
MONGODB_URI=

# Your phone number — userId for your UserConfig
OWNER_PHONE_NUMBER=
